from typing import overload

versions: tuple[int, ...]

class ProtocolVersion:
    @property
    def number(self) -> int: ...
    @property
    def snapshot(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def first(self) -> str: ...
    @property
    def last(self) -> str: ...

releases: tuple[ProtocolVersion, ...]

@overload
def protocol_version(number: int) -> ProtocolVersion | None: ...
@overload
def protocol_version(release: str) -> ProtocolVersion | None: ...
