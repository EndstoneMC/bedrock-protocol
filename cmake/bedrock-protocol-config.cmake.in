@PACKAGE_INIT@

if (@BEDROCK_PROTOCOL_HAS_WIRE@)
    include(CMakeFindDependencyMacro)
    find_dependency(OpenSSL COMPONENTS Crypto)
    find_dependency(ZLIB)
    find_dependency(Snappy CONFIG)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/bedrock-protocol-targets.cmake")

check_required_components(bedrock-protocol)
