from collections.abc import Collection, Iterable, Iterator, Sequence
from enum import Enum

from . import Codec, DecodedPacket, EncodedPacket, Packet, PacketHeader, ReadableBuffer

class Compression(Enum):
    ZLIB = 0
    SNAPPY = 1
    NONE = 65535

class PacketDecodeError:
    @property
    def protocol(self) -> int: ...
    @property
    def packet_index(self) -> int: ...
    @property
    def header(self) -> PacketHeader: ...
    @property
    def offset(self) -> int: ...
    @property
    def reason(self) -> str: ...

class PacketBatch:
    @property
    def protocol(self) -> int: ...
    @property
    def filtered(self) -> bool: ...
    @property
    def packet_count(self) -> int: ...
    @property
    def decoded_count(self) -> int: ...
    @property
    def headers(self) -> tuple[PacketHeader, ...]: ...
    @property
    def skipped_packet_ids(self) -> tuple[int, ...]: ...
    @property
    def errors(self) -> tuple[PacketDecodeError, ...]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> DecodedPacket: ...
    def __iter__(self) -> Iterator[DecodedPacket]: ...

class BatchCodec:
    def __init__(self, codec: Codec) -> None: ...
    def encode(self, packets: Sequence[Packet]) -> bytes: ...
    def encode_prepared(self, packets: Iterable[EncodedPacket]) -> bytes: ...
    def decode(
        self, data: ReadableBuffer, *, packet_ids: Collection[int] | None = None, recover_packet_errors: bool = False
    ) -> PacketBatch: ...
    def set_compression(self, algorithm: Compression, threshold: int) -> None: ...
    def enable_encryption(self, key: ReadableBuffer) -> None: ...
